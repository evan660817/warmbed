\cb3                                 \})\}</div>\cb1 \
\cb3                                 \{currentQ?.type === 'multi' && (<button onClick=\{nextMultiStep\} disabled=\{selectedOptions.length === 0\} className="w-full py-5 bg-white text-black rounded-2xl font-bold hover:tracking-widest transition-all disabled:opacity-20 shadow-xl mt-4">\uc0\u30906 \u35469 \u25351 \u24341  <Icons.ChevronRight /></button>)\}\cb1 \
\cb3                             </div>\cb1 \
\cb3                         </div>\cb1 \
\cb3                     )\}\cb1 \
\
\cb3                     \{step === 'message' && (\cb1 \
\cb3                         <div className="min-h-screen flex items-center justify-center p-6 animate-fade-in text-center">\cb1 \
\cb3                             <div className="glass-panel p-10 rounded-3xl max-w-md w-full space-y-8">\cb1 \
\cb3                                 <div className="flex justify-center text-white/50"><Icons.Skull /></div>\cb1 \
\cb3                                 <h2 className="text-2xl font-serif text-white tracking-widest">\uc0\u23565 \u21629 \u36939 \u24341 \u36335 \u20154 \u30340 \u31169 \u35486 </h2>\cb1 \
\cb3                                 <textarea className="w-full h-48 bg-white/5 border border-white/10 p-6 rounded-2xl focus:outline-none focus:border-white/30 text-white resize-none placeholder-white/10 text-center" placeholder="\uc0\u23531 \u19979 \u20320 \u23565 \u36523 \u20221 \u30340 \u26399 \u35377 ..." value=\{userData.message\} onChange=\{e => setUserData(\{...userData, message: e.target.value\})\} />\cb1 \
\cb3                                 <button onClick=\{submitFinal\} disabled=\{loading\} className="w-full py-5 bg-white text-black font-bold rounded-2xl text-xl transition-all shadow-2xl flex items-center justify-center gap-2 hover:bg-gray-100 transition-colors">\{loading ? '\uc0\u26143 \u36556 \u35336 \u31639 \u20013 ...' : '\u21051 \u19979 \u38728 \u39746 \u22865 \u32004 '\} <Icons.ChevronRight /></button>\cb1 \
\cb3                             </div>\cb1 \
\cb3                         </div>\cb1 \
\cb3                     )\}\cb1 \
\
\cb3                     \{step === 'result' && (() => \{\cb1 \
\cb3                         const fp = calculatePercentages(scores);\cb1 \
\cb3                         const sorted = Object.entries(fp).sort((a,b) => b[1] - a[1]).map(([id, pct]) => (\{ ...ALL_CHARACTERS.find(c => c.id === id), pct \}));\cb1 \
\cb3                         return (\cb1 \
\cb3                             <div className="min-h-screen py-20 px-6 overflow-y-auto animate-fade-in flex flex-col items-center text-center">\cb1 \
\cb3                                 <div className="max-w-6xl w-full space-y-16">\cb1 \
\cb3                                     <div className="space-y-4"><h2 className="text-sm font-serif tracking-[1em] text-white/40 uppercase">\uc0\u26143 \u36556 \u23450 \u35542 </h2><h1 className="text-5xl font-serif text-white tracking-[0.2em]">\u38728 \u39746 \u22865 \u21512 \u22577 \u21578 </h1></div>\cb1 \
\cb3                                     <div className="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">\cb1 \
\cb3                                         \{sorted.map((c, i) => (\cb1 \
\cb3                                             <div key=\{c.id\} className=\{`glass-panel rounded-3xl overflow-hidden transition-all duration-1000 transform animate-fade-in $\{i === 0 ? 'destiny-glow scale-105 z-10' : 'opacity-70 grayscale-[30%] hover:grayscale-0 hover:scale-102 hover:opacity-100'\}`\} style=\{\{ animationDelay: `$\{i * 0.3\}s` \}\}>\cb1 \
\cb3                                                 <div className="relative aspect-[3/4] overflow-hidden text-left"><img src=\{c.img\} className="w-full h-full object-cover" onError=\{e=>e.target.src='https://via.placeholder.com/400x600?text='+c.name\}/><div className="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div><div className="absolute top-4 right-4 bg-white text-black px-4 py-1 rounded-full font-serif font-bold text-lg">\{c.pct\}%</div><div className="absolute bottom-6 left-0 right-0 text-center text-white"><h3 className="text-4xl font-serif font-bold tracking-[0.3em]">\{c.name\}</h3>\{i === 0 && <span className="text-[10px] uppercase tracking-[0.5em] text-yellow-500 font-bold">\uc0\u21629 \u23450 \u20043 \u36984 </span>\}</div></div>\cb1 \
\cb3                                                 <div className="p-8 space-y-6 text-left"><div className="h-1 w-full bg-white/5 rounded-full overflow-hidden"><div className=\{`h-full transition-all duration-1000 delay-500 $\{i === 0 ? 'bg-white bar-glow' : 'bg-white/40'\}`\} style=\{\{ width: `$\{c.pct\}%` \}\}></div></div><p className="text-gray-200 text-sm font-light italic leading-relaxed text-center">\uc0\u12300 \{c.quote\}\u12301 </p></div>\cb1 \
\cb3                                             </div>\cb1 \
\cb3                                         ))\}\cb1 \
\cb3                                     </div>\cb1 \
\cb3                                     <div className="glass-panel p-10 rounded-3xl max-w-2xl mx-auto space-y-4"><p className="text-white/60 text-sm tracking-widest leading-loose">\uc0\u26143 \u36556 \u39023 \u31034 \u20320 \u30340 \u38728 \u39746 \u20855 \u26377 \u22810 \u37325 \u20999 \u38754 \u65292 <br/>\u32080 \u26524 \u24050 \u20132 \u30001 \u12300 \u21629 \u36939 \u24341 \u36335 \u20154 \u12301 \u30041 \u23384 \u12290 </p><div className="pt-6 border-t border-white/10 text-[10px] text-white/20 tracking-[.5em] uppercase">Fate synchronized to DM.</div></div>\cb1 \
\cb3                                 </div>\cb1 \
\cb3                             </div>\cb1 \
\cb3                         );\cb1 \
\cb3                     \})()\}\cb1 \
\
\cb3                     \{step === 'admin_login' && (\cb1 \
\cb3                         <div className="min-h-screen flex items-center justify-center p-6 animate-fade-in text-center">\cb1 \
\cb3                             <div className="glass-panel p-10 rounded-3xl w-full max-w-sm space-y-6 shadow-2xl">\cb1 \
\cb3                                 <h2 className="text-2xl font-serif text-white tracking-widest uppercase">\uc0\u24341 \u36335 \u20154 \u39511 \u35657 </h2>\cb1 \
\cb3                                 <input type="password" id="adminPwd" className="w-full bg-black/50 border border-white/10 p-4 rounded-xl text-center text-white focus:outline-none" placeholder="\uc0\u36664 \u20837 \u31192 \u38000 " />\cb1 \
\cb3                                 <button onClick=\{() => \{ if (document.getElementById('adminPwd').value === 'warmbed888') setStep('admin'); else alert('\uc0\u37679 \u35492 '); \}\} className="w-full py-4 bg-white text-black font-bold rounded-xl hover:bg-gray-100 transition-all shadow-xl uppercase tracking-widest">\u38283 \u21855 \u24460 \u21488 </button>\cb1 \
\cb3                                 <button onClick=\{() => setStep('landing')\} className="w-full text-white/20 text-xs mt-4 tracking-widest uppercase">\uc0\u36820 \u22238 \u36855 \u38695 \u39318 \u38913 </button>\cb1 \
\cb3                             </div>\cb1 \
\cb3                         </div>\cb1 \
\cb3                     )\}\cb1 \
\
\cb3                     \{step === 'admin' && (\cb1 \
\cb3                         <div className="min-h-screen p-10 bg-black/90 backdrop-blur-3xl overflow-y-auto animate-fade-in">\cb1 \
\cb3                             <div className="max-w-7xl mx-auto space-y-16">\cb1 \
\cb3                                 <div className="flex justify-between items-end border-b border-white/10 pb-8"><div className="flex items-center gap-4 text-white text-left"><Icons.Settings /><h1 className="text-4xl font-serif tracking-[.2em] uppercase">\uc0\u28331 \u24202 \u12539 \u22825 \u31204 \u35264 \u28204 \u21488 </h1></div><button onClick=\{() => setStep('landing')\} className="text-white/30 text-sm uppercase transition-colors hover:text-white tracking-widest">Logout</button></div>\cb1 \
\cb3                                 \{(() => \{\cb1 \
