\cb3             const [selectedOptions, setSelectedOptions] = useState([]);\cb1 \
\cb3             const [allResponses, setAllResponses] = useState([]);\cb1 \
\cb3             const [loading, setLoading] = useState(false);\cb1 \
\cb3             const [dateState, setDateState] = useState(\{ year: today.getFullYear(), month: today.getMonth() + 1, day: today.getDate() \});\cb1 \
\cb3             const [userData, setUserData] = useState(\{ name: '', gender: 'male', gameDate: '', gameTime: '14:00', message: '' \});\cb1 \
\
\cb3             const currentQuestions = useMemo(() => userData.gender === 'male' ? QUESTIONS_MALE : QUESTIONS_FEMALE, [userData.gender]);\cb1 \
\cb3             const currentQ = useMemo(() => currentQuestions[currentQIndex] || currentQuestions[0], [currentQuestions, currentQIndex]);\cb1 \
\
\cb3             useEffect(() => \{\cb1 \
\cb3                 setUserData(prev => (\{ ...prev, gameDate: `$\{dateState.year\}-$\{String(dateState.month).padStart(2,'0')\}-$\{String(dateState.day).padStart(2,'0')\}` \}));\cb1 \
\cb3             \}, [dateState]);\cb1 \
\
\cb3             useEffect(() => \{\cb1 \
\cb3                 const initAuth = async () => \{\cb1 \
\cb3                     try \{\cb1 \
\cb3                         if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) \{\cb1 \
\cb3                             await signInWithCustomToken(auth, __initial_auth_token);\cb1 \
\cb3                         \} else \{\cb1 \
\cb3                             await signInAnonymously(auth);\cb1 \
\cb3                         \}\cb1 \
\cb3                     \} catch (err) \{ console.error("Auth error", err); \}\cb1 \
\cb3                 \};\cb1 \
\cb3                 initAuth();\cb1 \
\cb3                 const unsubscribe = onAuthStateChanged(auth, setUser);\cb1 \
\cb3                 return () => unsubscribe();\cb1 \
\cb3             \}, []);\cb1 \
\
\cb3             useEffect(() => \{\cb1 \
\cb3                 if (!user || step !== 'admin') return;\cb1 \
\cb3                 const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'responses');\cb1 \
\cb3                 const q = query(colRef);\cb1 \
\cb3                 const unsubscribe = onSnapshot(q, (snapshot) => \{\cb1 \
\cb3                     const data = snapshot.docs.map(doc => (\{ id: doc.id, ...doc.data() \}));\cb1 \
\cb3                     // Sort by submission timestamp primarily\cb1 \
\cb3                     data.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));\cb1 \
\cb3                     setAllResponses(data);\cb1 \
\cb3                 \}, (err) => console.error("Firestore error:", err));\cb1 \
\cb3                 return () => unsubscribe();\cb1 \
\cb3             \}, [user, step]);\cb1 \
\
\cb3             const toggleMusic = () => \{\cb1 \
\cb3                 if (audioRef.current) \{\cb1 \
\cb3                     if (isMusicPlaying) audioRef.current.pause();\cb1 \
\cb3                     else audioRef.current.play();\cb1 \
\cb3                     setIsMusicPlaying(!isMusicPlaying);\cb1 \
\cb3                 \}\cb1 \
\cb3             \};\cb1 \
\
\cb3             const handleStart = () => \{\cb1 \
\cb3                 if (audioRef.current) audioRef.current.play().then(() => setIsMusicPlaying(true)).catch(() => \{\});\cb1 \
\cb3                 setStep('info'); window.scrollTo(0, 0);\cb1 \
\cb3             \};\cb1 \
\
\cb3             const handleOptionClick = (o) => \{\cb1 \
\cb3                 if (currentQ.type === 'single') \{\cb1 \
\cb3                     const ns = \{ ...scores \};\cb1 \
\cb3                     Object.entries(o.scores).forEach(([c, v]) => ns[c] = (ns[c] || 0) + v);\cb1 \
\cb3                     setScores(ns);\cb1 \
\cb3                     if (currentQIndex < currentQuestions.length - 1) setCurrentQIndex(currentQIndex + 1);\cb1 \
\cb3                     else setStep('message');\cb1 \
\cb3                     window.scrollTo(0, 0);\cb1 \
\cb3                 \} else \{\cb1 \
\cb3                     setSelectedOptions(p => p.find(x => x.text === o.text) ? p.filter(x => x.text !== o.text) : [...p, o]);\cb1 \
\cb3                 \}\cb1 \
\cb3             \};\cb1 \
\
\cb3             const nextMultiStep = () => \{\cb1 \
\cb3                 const ns = \{ ...scores \};\cb1 \
\cb3                 selectedOptions.forEach(o => Object.entries(o.scores).forEach(([c, v]) => ns[c] = (ns[c] || 0) + v));\cb1 \
\cb3                 setScores(ns); setSelectedOptions([]);\cb1 \
\cb3                 if (currentQIndex < currentQuestions.length - 1) setCurrentQIndex(currentQIndex + 1);\cb1 \
\cb3                 else setStep('message');\cb1 \
\cb3                 window.scrollTo(0, 0);\cb1 \
\cb3             \};\cb1 \
\
\cb3             const submitFinal = async () => \{\cb1 \
\cb3                 if (!user) return;\cb1 \
\cb3                 setLoading(true);\cb1 \
\cb3                 try \{\cb1 \
\cb3                     const result = Object.entries(scores).reduce((a, b) => a[1] > b[1] ? a : b)[0];\cb1 \
\cb3                     await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'responses'), \{ \cb1 \
\cb3                         ...userData, scores, result, timestamp: new Date().toISOString(), uid: user.uid \cb1 \
\cb3                     \});\cb1 \
\cb3                     setStep('result');\cb1 \
\cb3                 \} finally \{\cb1 \
\cb3                     setLoading(false);\cb1 \
\cb3                     window.scrollTo(0, 0);\cb1 \
\cb3                 \}\cb1 \
\cb3             \};\cb1 \
\
\cb3             const calculatePercentages = (playerScores) => \{\cb1 \
\cb3                 const sv = Object.values(playerScores);\cb1 \
\cb3                 const tp = sv.reduce((a, v) => a + Math.max(0, v), 0);\cb1 \
\cb3                 const res = \{\};\cb1 \
\cb3                 Object.entries(playerScores).forEach(([k, v]) => res[k] = tp === 0 ? 33 : Math.round((Math.max(0, v) / tp) * 100));\cb1 \
\cb3                 return res;\cb1 \
\cb3             \};\cb1 \
\
\cb3             return (\cb1 \
\cb3                 <div className="relative min-h-screen">\cb1 \
\cb3                     <div className="app-bg"></div>\cb1 \
\cb3                     <audio ref=\{audioRef\} src="Lana Del Rey - Young And Beautiful.mp3" loop />\cb1 \
\cb3                     \cb1 \
\cb3                     <div className="fixed top-6 right-6 z-50 flex items-center gap-3">\cb1 \
\cb3                         \{step === 'landing' && (\cb1 \
\cb3                             <button onClick=\{() => setStep('admin_login')\} className="p-3 glass-panel rounded-full text-white/60 hover:text-white transition-all hover:scale-110 active:scale-95 flex items-center gap-2 group"><Icons.Settings /><span className="max-w-0 overflow-hidden group-hover:max-w-xs transition-all duration-500 whitespace-nowrap text-xs tracking-widest uppercase">\uc0\u24460 \u21488 \u32080 \u26524 </span></button>\cb1 \
\cb3                         )\}\cb1 \
\cb3                         <button onClick=\{toggleMusic\} className="p-3 glass-panel rounded-full text-white/60 hover:text-white transition-all hover:scale-110 active:scale-95"><Icons.Music active=\{isMusicPlaying\} /></button>\cb1 \
\cb3                     </div>\cb1 \
\
\cb3                     \{step === 'landing' && (\cb1 \
\cb3                         <div className="min-h-screen flex flex-col items-center py-12 px-6 space-y-16 animate-fade-in text-center">\cb1 \
\cb3                             <div className="glass-panel p-12 rounded-3xl max-w-xl w-full space-y-8 shadow-2xl mt-12">\cb1 \
\cb3                                 <div className="flex justify-center text-yellow-500 animate-pulse"><Icons.Crown /></div>\cb1 \
\cb3                                 <h1 className="text-6xl font-serif tracking-[0.3em] text-white drop-shadow-lg w-full">\uc0\u28331 \u24202 </h1>\cb1 \
\cb3                                 <p className="text-lg text-gray-300 leading-loose tracking-widest">\uc0\u12300 \u20154 \u32317 \u24859 \u22312 \u32618 \u24801 \u30340 \u28331 \u24202 \u35041 \u65292 \u23563 \u25214 \u19968 \u20301 \u31070 \u12290 \u12301 <br/>\u27402 \u21147 \u12289 \u27442 \u26395 \u12289 \u32972 \u24503 \u33287 \u32020 \u24859 \u12290 <br/>\u26143 \u30436 \u36681 \u21205 \u65292 \u35504 \u23559 \u33287 \u20320 \u30340 \u38728 \u39746 \u20849 \u40180 \u65311 </p>\cb1 \
\cb3                                 <button onClick=\{handleStart\} className="w-full py-5 bg-white/10 hover:bg-white/20 border border-white/20 rounded-full text-xl font-bold transition-all hover:tracking-widest shadow-xl">\uc0\u36914 \u20837 \u32034 \u22810 \u29802 </button>\cb1 \
\cb3                                 <button onClick=\{() => setStep('admin_login')\} className="text-white/20 text-xs hover:text-white/50 pt-4 flex items-center justify-center gap-1 transition-colors uppercase tracking-[0.2em]"><Icons.Lock /> \uc0\u21629 \u36939 \u24341 \u36335 \u20154 \u30331 \u20837 </button>\cb1 \
\cb3                             </div>\cb1 \
\cb3                             <div className="w-full max-w-6xl space-y-12">\cb1 \
\cb3                                 <div className="flex flex-col items-center space-y-4 text-center"><div className="flex items-center gap-4 text-white/60 uppercase tracking-[0.5em] text-sm"><div className="hidden md:block w-12 h-[1px] bg-white/20"></div>\uc0\u32034 \u22810 \u29802 \u30340 \u30526 \u29983 \u30456 <div className="hidden md:block w-12 h-[1px] bg-white/20"></div></div><Icons.Eye /></div>\cb1 \
\cb3                                 <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">\cb1 \
\cb3                                     \{ALL_CHARACTERS.map(char => (\cb1 \
\cb3                                         <div key=\{char.id\} className="glass-panel rounded-3xl overflow-hidden group border-white/5 hover:border-white/20 transition-all duration-500 text-left"><div className="relative aspect-[3/4] overflow-hidden"><img src=\{char.img\} className="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" onError=\{e=>e.target.src='https://via.placeholder.com/400x600?text='+char.name\}/><div className="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-80"></div><div className="absolute bottom-6 left-6 right-6"><h3 className="text-3xl font-serif font-bold text-white tracking-[0.2em]">\{char.name\}</h3></div></div><div className="p-8"><p className="text-gray-300 text-sm font-light italic leading-relaxed text-left">\uc0\u12300 \{char.quote\}\u12301 </p></div></div>\cb1 \
\cb3                                     ))\}\cb1 \
\cb3                                 </div>\cb1 \
\cb3                             </div>\cb1 \
\cb3                             <div className="pt-20 pb-10 text-white/10 text-xs tracking-widest uppercase text-center w-full">Sodom's Fate System &copy; Warm Bed</div>\cb1 \
