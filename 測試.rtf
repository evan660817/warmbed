\cb3                                 <h2 className="text-4xl font-serif text-white leading-relaxed tracking-wider drop-shadow-lg text-center">\{currentQ?.title\}</h2>\cb1 \
\cb3                                 <div className="space-y-4 text-left">\{currentQ?.options.map((o, i) => \{\cb1 \
\cb3                                     const sel = selectedOptions.find(x => x.text === o.text);\cb1 \
