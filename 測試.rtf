\cb3                                 <input type="text" required placeholder="\uc0\u35531 \u36664 \u20837 \u21517 \u35569 " className="w-full bg-white/5 border border-white/10 p-4 rounded-xl text-white placeholder-white/20 focus:outline-none focus:border-white/40 transition-all text-center" value=\{userData.name\} onChange=\{e => setUserData(\{...userData, name: e.target.value\})\} />\cb1 \
\cb3                                 <div className="flex gap-4">\cb1 \
\cb3                                     <button type="button" onClick=\{() => setUserData(\{...userData, gender: 'male'\})\} className=\{`flex-1 py-4 rounded-xl border transition-all $\{userData.gender === 'male' ? 'bg-blue-600/30 border-blue-400 text-blue-100 shadow-xl' : 'bg-white/5 border-white/10 text-white/30'\}`\}>\uc0\u30007 \u24615 </button>\cb1 \
\cb3                                     <button type="button" onClick=\{() => setUserData(\{...userData, gender: 'female'\})\} className=\{`flex-1 py-4 rounded-xl border transition-all $\{userData.gender === 'female' ? 'bg-pink-600/30 border-pink-400 text-pink-100 shadow-xl' : 'bg-white/5 border-white/10 text-white/30'\}`\}>\uc0\u22899 \u24615 </button>\cb1 \
