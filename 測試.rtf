\cb3                                         <select className="bg-white/5 border border-white/10 p-3 rounded-xl text-white appearance-none text-center focus:outline-none" value=\{dateState.day\} onChange=\{e => setDateState(\{...dateState, day: parseInt(e.target.value)\})\}>\{DAYS.map(d => <option key=\{d\} value=\{d\}>\{d\}\uc0\u26085 </option>)\}</select>\cb1 \
\cb3                                     </div>\cb1 \
\cb3                                     <select className="w-full bg-white/5 border border-white/10 p-3 rounded-xl text-white appearance-none text-center mt-2 focus:outline-none" value=\{userData.gameTime\} onChange=\{e => setUserData(\{...userData, gameTime: e.target.value\})\}>\{HOURS.map(h => <option key=\{h\} value=\{h\}>\{h\}</option>)\}</select>\cb1 \
\cb3                                 </div>\cb1 \
\cb3                                 <button onClick=\{() => setStep('quiz')\} className="w-full py-5 bg-white text-black font-bold rounded-xl shadow-2xl hover:bg-gray-100 transition-colors">\uc0\u25765 \u38283 \u36855 \u38695 </button>\cb1 \
\cb3                             </div>\cb1 \
\cb3                         </div>\cb1 \
\cb3                     )\}\cb1 \
\
\cb3                     \{step === 'quiz' && (\cb1 \
\cb3                         <div className="min-h-screen p-6 animate-fade-in flex flex-col items-center">\cb1 \
